@{
    ViewData["Title"] = "Мониторинг — EduBank";
}

@section Styles {
<style>
    .controls {
        background: #1e293b; border-bottom: 1px solid #334155;
        padding: 10px 24px; display: flex; gap: 16px;
        align-items: center; flex-wrap: wrap;
    }
    .controls label { font-size: 13px; color: #94a3b8; }
    select {
        background: #0f172a; color: #e2e8f0;
        border: 1px solid #334155; border-radius: 6px;
        padding: 6px 10px; font-size: 13px; cursor: pointer;
    }
    select:focus { outline: none; border-color: #38bdf8; }
    .refresh-info { margin-left: auto; font-size: 12px; color: #475569; }

    main { padding: 24px; max-width: 1600px; margin: 0 auto; }

    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 20px; }
    .card .lbl { font-size: 11px; text-transform: uppercase; letter-spacing: .8px; color: #64748b; margin-bottom: 8px; }
    .card .val { font-size: 30px; font-weight: 700; color: #f8fafc; }
    .card .sub { font-size: 12px; color: #475569; margin-top: 4px; }
    .card.c-error .val { color: #f87171; }
    .card.c-warn  .val { color: #fbbf24; }
    .card.c-good  .val { color: #4ade80; }

    .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(480px, 1fr)); gap: 20px; margin-bottom: 28px; }
    .chart-card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 20px; }
    .chart-card h2 { font-size: 13px; font-weight: 600; color: #64748b; margin-bottom: 16px; text-transform: uppercase; letter-spacing: .6px; }
    .chart-wrap { position: relative; height: 220px; }

    .section { margin-bottom: 28px; }
    .section h2 { font-size: 13px; font-weight: 600; color: #64748b; text-transform: uppercase; letter-spacing: .6px; margin-bottom: 12px; }
    .tbl-wrap { overflow-x: auto; border-radius: 12px; border: 1px solid #334155; }
    table { width: 100%; border-collapse: collapse; background: #1e293b; font-size: 13px; }
    th {
        background: #0f172a; color: #64748b; font-weight: 600;
        text-align: left; padding: 10px 14px;
        font-size: 11px; text-transform: uppercase; letter-spacing: .6px;
        border-bottom: 1px solid #334155;
    }
    td { padding: 10px 14px; border-bottom: 1px solid #0f172a; color: #cbd5e1; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #263348; }

    .pill { display: inline-block; border-radius: 9999px; padding: 2px 8px; font-size: 11px; font-weight: 600; }
    .p-ok   { background: #052e16; color: #4ade80; }
    .p-err  { background: #450a0a; color: #f87171; }
    .p-warn { background: #451a03; color: #fbbf24; }
    .p-blue { background: #0c2a4a; color: #38bdf8; }
    .mono   { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 11px; color: #7dd3fc; }

    .search-bar { margin-bottom: 12px; }
    .search-bar input {
        width: 100%; background: #0f172a; color: #e2e8f0;
        border: 1px solid #334155; border-radius: 6px;
        padding: 8px 12px; font-size: 13px;
    }
    .search-bar input:focus { outline: none; border-color: #38bdf8; }
    .search-bar input::placeholder { color: #475569; }
    .no-data { text-align: center; padding: 48px; color: #475569; font-size: 14px; }
</style>
}

<div class="controls">
    <label>Период:
        <select id="minutes">
            <option value="15">15 мин</option>
            <option value="30">30 мин</option>
            <option value="60" selected>1 час</option>
            <option value="360">6 часов</option>
            <option value="1440">24 часа</option>
        </select>
    </label>
    <label>Сервис:
        <select id="serviceFilter">
            <option value="">Все сервисы</option>
        </select>
    </label>
    <span class="refresh-info" id="refreshInfo">Обновление через 15 с</span>
</div>

<main>

    <div class="stats">
        <div class="card c-good">
            <div class="lbl">Запросов за период</div>
            <div class="val" id="statTotal">—</div>
            <div class="sub">всего за выбранный период</div>
        </div>
        <div class="card" id="cardError">
            <div class="lbl">Процент ошибок</div>
            <div class="val" id="statErrRate">—</div>
            <div class="sub" id="statErrAbs">5xx ответы</div>
        </div>
        <div class="card c-warn">
            <div class="lbl">Среднее время ответа</div>
            <div class="val" id="statAvg">—</div>
            <div class="sub">миллисекунды</div>
        </div>
        <div class="card">
            <div class="lbl">Макс. время ответа</div>
            <div class="val" id="statMax">—</div>
            <div class="sub">миллисекунды</div>
        </div>
        <div class="card">
            <div class="lbl">Активных сервисов</div>
            <div class="val" id="statSvcs">—</div>
            <div class="sub">за выбранный период</div>
        </div>
    </div>

    <div class="charts">
        <div class="chart-card">
            <h2>Запросы в минуту</h2>
            <div class="chart-wrap"><canvas id="chartRps"></canvas></div>
        </div>
        <div class="chart-card">
            <h2>Процент ошибок (%)</h2>
            <div class="chart-wrap"><canvas id="chartErr"></canvas></div>
        </div>
        <div class="chart-card">
            <h2>Среднее время ответа (мс)</h2>
            <div class="chart-wrap"><canvas id="chartDur"></canvas></div>
        </div>
    </div>

    <div class="section">
        <h2>Сводка по сервисам</h2>
        <div class="tbl-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Сервис</th>
                        <th>Запросов</th>
                        <th>Ошибок</th>
                        <th>Процент ошибок</th>
                        <th>Ср. время (мс)</th>
                        <th>Макс. время (мс)</th>
                    </tr>
                </thead>
                <tbody id="summaryBody">
                    <tr><td colspan="6" class="no-data">Загрузка…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="section">
        <h2>Последние запросы</h2>
        <div class="search-bar">
            <input type="text" id="traceSearch" placeholder="Поиск по path, сервису, trace ID, статусу…" />
        </div>
        <div class="tbl-wrap">
            <table id="tracesTable">
                <thead>
                    <tr>
                        <th>Время (UTC)</th>
                        <th>Сервис</th>
                        <th>Метод</th>
                        <th>Path</th>
                        <th>Статус</th>
                        <th>Время (мс)</th>
                        <th>Trace ID</th>
                    </tr>
                </thead>
                <tbody id="tracesBody">
                    <tr><td colspan="7" class="no-data">Загрузка…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

</main>

@section Scripts {
<script>
const PALETTE = ['#38bdf8','#4ade80','#fbbf24','#f87171','#a78bfa',
                 '#34d399','#fb923c','#e879f9','#60a5fa','#f472b6'];
const svcColor = {};
let colIdx = 0;
function color(name) {
    if (!svcColor[name]) svcColor[name] = PALETTE[colIdx++ % PALETTE.length];
    return svcColor[name];
}

Chart.defaults.color = '#64748b';
Chart.defaults.borderColor = '#1e293b';

function mkChart(id) {
    return new Chart(document.getElementById(id), {
        type: 'line',
        data: { labels: [], datasets: [] },
        options: {
            responsive: true, maintainAspectRatio: false, animation: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 9, padding: 12, font: { size: 11 } } },
                tooltip: { backgroundColor: '#1e293b', borderColor: '#334155', borderWidth: 1,
                           titleColor: '#f8fafc', bodyColor: '#cbd5e1' }
            },
            scales: {
                x: { grid: { color: '#1e293b' }, ticks: { maxRotation: 0, maxTicksLimit: 10, font: { size: 10 } } },
                y: { grid: { color: '#1e293b' }, beginAtZero: true, ticks: { font: { size: 10 } } }
            }
        }
    });
}

const cRps = mkChart('chartRps');
const cErr = mkChart('chartErr');
const cDur = mkChart('chartDur');

function setChart(ch, labels, datasets) {
    ch.data.labels = labels; ch.data.datasets = datasets; ch.update('none');
}

let allTraces = [];

async function load() {
    const mins = document.getElementById('minutes').value;
    const svc  = document.getElementById('serviceFilter').value;

    const [summary, timeline, traces] = await Promise.all([
        fetch(`/api/metrics/summary?minutes=${mins}`).then(r => r.json()).catch(() => []),
        fetch(`/api/metrics/timeline?minutes=${mins}`).then(r => r.json()).catch(() => []),
        fetch(`/api/traces/recent?limit=200${svc ? '&service='+encodeURIComponent(svc) : ''}`)
            .then(r => r.json()).catch(() => [])
    ]);

    allTraces = traces;
    fillServiceFilter(summary);
    fillCards(summary, svc);
    fillCharts(timeline, svc);
    fillSummary(summary, svc);
    fillTraces(document.getElementById('traceSearch').value);
}

function fillServiceFilter(summary) {
    const sel = document.getElementById('serviceFilter');
    const cur = sel.value;
    const known = new Set(Array.from(sel.options).map(o => o.value).filter(Boolean));
    summary.forEach(s => {
        if (!known.has(s.serviceName)) {
            const o = document.createElement('option');
            o.value = o.textContent = s.serviceName;
            sel.appendChild(o);
        }
    });
    sel.value = cur;
}

function fillCards(summary, filter) {
    const d = filter ? summary.filter(s => s.serviceName === filter) : summary;
    const total   = d.reduce((a, s) => a + s.totalRequests, 0);
    const errors  = d.reduce((a, s) => a + s.errors, 0);
    const errPct  = total ? errors / total * 100 : 0;
    const avgDur  = total ? d.reduce((a, s) => a + s.avgDurationMs * s.totalRequests, 0) / total : 0;
    const maxDur  = d.length ? Math.max(...d.map(s => s.maxDurationMs)) : 0;

    setText('statTotal',   total.toLocaleString('ru'));
    setText('statErrRate', errPct.toFixed(1) + '%');
    setText('statErrAbs',  `${errors} ошибок из ${total}`);
    setText('statAvg',     avgDur.toFixed(0) + ' мс');
    setText('statMax',     maxDur + ' мс');
    setText('statSvcs',    d.length);

    const ce = document.getElementById('cardError');
    ce.className = 'card ' + (errPct > 20 ? 'c-error' : errPct > 5 ? 'c-warn' : 'c-good');
}

function fillCharts(timeline, filter) {
    const rows = filter ? timeline.filter(r => r.service === filter) : timeline;
    const mins = [...new Set(rows.map(r => r.minute))].sort();
    const svcs = filter ? [filter] : [...new Set(rows.map(r => r.service))];
    const labels = mins.map(m => new Date(m).toLocaleTimeString('ru', { hour:'2-digit', minute:'2-digit' }));

    function ds(fn) {
        return svcs.map(s => {
            const byMin = {};
            rows.filter(r => r.service === s).forEach(r => { byMin[r.minute] = fn(r); });
            return { label: s, data: mins.map(m => byMin[m] ?? null),
                     borderColor: color(s), backgroundColor: color(s) + '20',
                     borderWidth: 2, pointRadius: 2, tension: 0.3, spanGaps: true };
        });
    }

    setChart(cRps, labels, ds(r => r.count));
    setChart(cErr, labels, ds(r => r.errorRatePercent));
    setChart(cDur, labels, ds(r => r.avgDurationMs));
}

function fillSummary(summary, filter) {
    const d = filter ? summary.filter(s => s.serviceName === filter) : summary;
    const tbody = document.getElementById('summaryBody');

    if (!d.length) {
        tbody.innerHTML = `<tr><td colspan="6" class="no-data">Нет данных за выбранный период</td></tr>`;
        return;
    }

    tbody.innerHTML = d
        .sort((a, b) => b.totalRequests - a.totalRequests)
        .map(s => {
            const pc = s.errorRatePercent > 20 ? 'p-err' : s.errorRatePercent > 5 ? 'p-warn' : 'p-ok';
            return `<tr>
                <td><span class="pill p-blue">${esc(s.serviceName)}</span></td>
                <td>${s.totalRequests.toLocaleString('ru')}</td>
                <td>${s.errors}</td>
                <td><span class="pill ${pc}">${s.errorRatePercent.toFixed(1)}%</span></td>
                <td>${s.avgDurationMs.toFixed(1)}</td>
                <td>${s.maxDurationMs}</td>
            </tr>`;
        }).join('');
}

function fillTraces(q) {
    q = (q || '').toLowerCase();
    const tbody = document.getElementById('tracesBody');

    const filtered = allTraces.filter(t =>
        !q ||
        t.path?.toLowerCase().includes(q) ||
        t.serviceName?.toLowerCase().includes(q) ||
        t.traceId?.toLowerCase().includes(q) ||
        String(t.statusCode).includes(q)
    );

    if (!filtered.length) {
        tbody.innerHTML = `<tr><td colspan="7" class="no-data">Нет данных</td></tr>`;
        return;
    }

    tbody.innerHTML = filtered.slice(0, 200).map(t => {
        const sc   = t.statusCode;
        const pc   = sc >= 500 ? 'p-err' : sc >= 400 ? 'p-warn' : 'p-ok';
        const time = new Date(t.timestamp).toLocaleTimeString('ru',
            { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        return `<tr>
            <td>${time}</td>
            <td><span class="pill p-blue">${esc(t.serviceName)}</span></td>
            <td><span class="pill p-blue">${esc(t.method)}</span></td>
            <td>${esc(t.path)}</td>
            <td><span class="pill ${pc}">${sc || 'ERR'}</span></td>
            <td>${t.durationMs} мс</td>
            <td class="mono">${esc(t.traceId||'')}</td>
        </tr>`;
    }).join('');
}

function setText(id, v) { document.getElementById(id).textContent = v; }
function esc(s) {
    return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

let countdown = 15;
function startCountdown() {
    countdown = 15;
    clearInterval(window._cd);
    const el = document.getElementById('refreshInfo');
    window._cd = setInterval(() => {
        countdown--;
        el.textContent = countdown > 0 ? `Обновление через ${countdown} с` : 'Обновление…';
        if (countdown <= 0) { clearInterval(window._cd); load().then(startCountdown); }
    }, 1000);
}

document.getElementById('minutes').addEventListener('change', load);
document.getElementById('serviceFilter').addEventListener('change', load);
document.getElementById('traceSearch').addEventListener('input', e => fillTraces(e.target.value));

load().then(startCountdown);
</script>
}
